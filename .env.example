ANTHROPIC_API_KEY=your_api_key_here
# Ramify RR - Environment Configuration

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string

# ElevenLabs API Key (required for voice cloning)
# Sign up at https://elevenlabs.io to get your API key
ELEVENLABS_API_KEY=

# ElevenLabs Voice Model (default: eleven_multilingual_v2)
ELEVENLABS_MODEL=eleven_multilingual_v2

# Upload and output directories
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs

# Maximum file size in MB
MAX_CONTENT_LENGTH_MB=500

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base
